# Optional. If unset, /ask still returns retrieved passages without a generated summary.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Local alternative: Ollama OpenAI-compatible endpoint
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=llama3.1

# Optional shared secret. If set, callers must send: Authorization: Bearer <key>
BIBLERAG_API_KEY=

HOST=0.0.0.0
PORT=8000
